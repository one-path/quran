{
    "title": "Аль-Фатиха",
    "verses": [
        {
            "id": 1,
            "translation": "Во имя Аллаха, Милостивого, Милосердного!",
            "words": [
                { "ar": "بِسْمِ", "ru": "во имя" },
                { "ar": "اللَّهِ", "ru": "Аллаха" },
                { "ar": "الرَّحْمَٰنِ", "ru": "Милостивого" },
                { "ar": "الرَّحِيمِ", "ru": "Милосердного" }
            ]
        },
        {
            "id": 2,
            "translation": "Хвала Аллаху, Господу миров,",
            "words": [
                { "ar": "الْحَمْدُ", "ru": "хвала" },
                { "ar": "لِلَّهِ", "ru": "Аллаху" },
                { "ar": "رَبِّ", "ru": "Господу" },
                { "ar": "الْعَالَمِينَ", "ru": "миров" }
            ]
        },
        {
            "id": 3,
            "translation": "Милостивого, Милосердного,",
            "words": [
                { "ar": "الرَّحْمَٰنِ", "ru": "Милостивого" },
                { "ar": "الرَّحِيمِ", "ru": "Милосердного" }
            ]
        },
        {
            "id": 4,
            "translation": "Властелина Дня суда!",
            "words": [
                { "ar": "مَالِكِ", "ru": "Властелина" },
                { "ar": "يَوْمِ", "ru": "Дня" },
                { "ar": "الدِّينِ", "ru": "суда" }
            ]
        },
        {
            "id": 5,
            "translation": "Тебе одному мы поклоняемся и Тебя одного просим о помощи.",
            "words": [
                { "ar": "إِيَّاكَ", "ru": "Тебя одного" },
                { "ar": "نَعْبُدُ", "ru": "мы поклоняемся" },
                { "ar": "وَإِيَّاكَ", "ru": "и Тебя одного" },
                { "ar": "نَسْتَعِينُ", "ru": "просим о помощи" }
            ]
        },
        {
            "id": 6,
            "translation": "Веди нас прямым путем,",
            "words": [
                { "ar": "اهْدِنَا", "ru": "веди нас" },
                { "ar": "الصِّرَاطَ", "ru": "путем" },
                { "ar": "الْمُسْتَقِيمَ", "ru": "прямым" }
            ]
        },
        {
            "id": 7,
            "translation": "путем тех, кого Ты облагодетельствовал, не тех, на кого пал гнев, и не заблудших.",
            "words": [
                { "ar": "صِرَاطَ", "ru": "путем" },
                { "ar": "الَّذِينَ", "ru": "тех, кого" },
                { "ar": "أَنْعَمْتَ", "ru": "Ты облагодетельствовал" },
                { "ar": "عَلَيْهِمْ", "ru": "на них" },
                { "ar": "غَيْرِ", "ru": "не" },
                { "ar": "الْمَغْضُوبِ", "ru": "те, на кого пал гнев" },
                { "ar": "عَلَيْهِمْ", "ru": "их" },
                { "ar": "وَلَا", "ru": "и не" },
                { "ar": "الضَّالِّينَ", "ru": "заблудших" }
            ]
        }
    ]
}
