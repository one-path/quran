{
    "title": "Аль-Бакара (аяты 1-5)",
    "verses": [
        {
            "id": 1,
            "translation": "Алиф. Лам. Мим.",
            "words": [
                { "ar": "الم", "ru": "Алиф. Лам. Мим." }
            ]
        },
        {
            "id": 2,
            "translation": "Эту Книгу — в которой нет сомнения — руководство для богобоязненных,",
            "words": [
                { "ar": "ذَلِكَ", "ru": "это" },
                { "ar": "الْكِتَابُ", "ru": "Писание" },
                { "ar": "لَا", "ru": "нет" },
                { "ar": "رَيْبَ", "ru": "сомнения" },
                { "ar": "فِيهِ", "ru": "в нем" },
                { "ar": "هُدًى", "ru": "руководство" },
                { "ar": "لِلْمُتَّقِينَ", "ru": "для богобоязненных" }
            ]
        },
        {
            "id": 3,
            "translation": "которые веруют в сокровенное, совершают молитву и расходуют из того, чем Мы их наделили,",
            "words": [
                { "ar": "الَّذِينَ", "ru": "те, которые" },
                { "ar": "يُؤْمِنُونَ", "ru": "веруют" },
                { "ar": "بِالْغَيْبِ", "ru": "в сокровенное" },
                { "ar": "وَيُقِيمُونَ", "ru": "и совершают" },
                { "ar": "الصَّلَاةَ", "ru": "молитву" },
                { "ar": "وَمِمَّا", "ru": "и из того, чем" },
                { "ar": "رَزَقْنَاهُمْ", "ru": "Мы их наделили" },
                { "ar": "يُنْفِقُونَ", "ru": "они расходуют" }
            ]
        },
        {
            "id": 4,
            "translation": "которые веруют в ниспосланное тебе и ниспосланное до тебя и убеждены в Последней жизни.",
            "words": [
                { "ar": "وَالَّذِينَ", "ru": "и те, которые" },
                { "ar": "يُؤْمِنُونَ", "ru": "веруют" },
                { "ar": "بِمَا", "ru": "в то, что" },
                { "ar": "أُنْزِلَ", "ru": "ниспослано" },
                { "ar": "إِلَيْكَ", "ru": "тебе" },
                { "ar": "وَمَا", "ru": "и в то, что" },
                { "ar": "أُنْزِلَ", "ru": "ниспослано" },
                { "ar": "مِنْ", "ru": "до" },
                { "ar": "قَبْلِكَ", "ru": "тебя" },
                { "ar": "وَبِالْآخِرَةِ", "ru": "и в Последнюю жизнь" },
                { "ar": "هُمْ", "ru": "они" },
                { "ar": "يُوقِنُونَ", "ru": "убеждены" }
            ]
        },
        {
            "id": 5,
            "translation": "Они следуют руководству от их Господа, и они являются преуспевшими.",
            "words": [
                { "ar": "أُولَئِكَ", "ru": "таковые" },
                { "ar": "عَلَى", "ru": "на" },
                { "ar": "هُدًى", "ru": "пути руководства" },
                { "ar": "مِنْ", "ru": "от" },
                { "ar": "رَبِّهِمْ", "ru": "их Господа" },
                { "ar": "وَأُولَئِكَ", "ru": "и таковые" },
                { "ar": "هُمُ", "ru": "они" },
                { "ar": "الْمُفْلِحُونَ", "ru": "преуспевшие" }
            ]
        },{
            "id": 6,
            "translation": "Воистину, неверующим все равно — предостерег ты их или не предостерег — они не веруют.",
            "words": [
                { "ar": "إِنَّ", "ru": "воистину" },
                { "ar": "الَّذِينَ", "ru": "те, которые" },
                { "ar": "كَفَرُوا", "ru": "не уверовали" },
                { "ar": "سَوَاءٌ", "ru": "все равно" },
                { "ar": "عَلَيْهِمْ", "ru": "для них" },
                { "ar": "أَأَنْذَرْتَهُمْ", "ru": "предостерег ли ты их" },
                { "ar": "أَمْ", "ru": "или" },
                { "ar": "لَمْ", "ru": "не" },
                { "ar": "تُنْذِرْهُمْ", "ru": "предостерег ты их" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "يُؤْمِنُونَ", "ru": "уверуют" }
            ]
        },
        {
            "id": 7,
            "translation": "Аллах наложил печать на их сердца и на их слух, а на глазах у них — покрывало. Им уготована великая мука.",
            "words": [
                { "ar": "خَتَمَ", "ru": "наложил печать" },
                { "ar": "اللَّهُ", "ru": "Аллах" },
                { "ar": "عَلَى", "ru": "на" },
                { "ar": "قُلُوبِهِمْ", "ru": "их сердца" },
                { "ar": "وَعَلَى", "ru": "и на" },
                { "ar": "سَمْعِهِمْ", "ru": "их слух" },
                { "ar": "وَعَلَى", "ru": "и на" },
                { "ar": "أَبْصَارِهِمْ", "ru": "их зрения" },
                { "ar": "غِشَاوَةٌ", "ru": "покрывало" },
                { "ar": "وَلَهُمْ", "ru": "и им" },
                { "ar": "عَذَابٌ", "ru": "наказание" },
                { "ar": "عَظِيمٌ", "ru": "великое" }
            ]
        },
        {
            "id": 8,
            "translation": "Среди людей есть такие, которые говорят: «Мы уверовали в Аллаха и в Последний день». Однако они не верующие.",
            "words": [
                { "ar": "وَمِنَ", "ru": "и среди" },
                { "ar": "النَّاسِ", "ru": "людей" },
                { "ar": "مَنْ", "ru": "те, которые" },
                { "ar": "يَقُولُ", "ru": "говорят" },
                { "ar": "آمَنَّا", "ru": "мы уверовали" },
                { "ar": "بِاللَّهِ", "ru": "в Аллаха" },
                { "ar": "وَبِالْيَوْمِ", "ru": "и в день" },
                { "ar": "الْآخِرِ", "ru": "Последний" },
                { "ar": "وَمَا", "ru": "но не" },
                { "ar": "هُمْ", "ru": "они" },
                { "ar": "بِمُؤْمِنِينَ", "ru": "верующие" }
            ]
        },
        {
            "id": 9,
            "translation": "Они пытаются обмануть Аллаха и верующих, но обманывают только самих себя, не осознавая этого.",
            "words": [
                { "ar": "يُخَادِعُونَ", "ru": "они пытаются обмануть" },
                { "ar": "اللَّهَ", "ru": "Аллаха" },
                { "ar": "وَالَّذِينَ", "ru": "и тех, которые" },
                { "ar": "آمَنُوا", "ru": "уверовали" },
                { "ar": "وَمَا", "ru": "но" },
                { "ar": "يَخْدَعُونَ", "ru": "обманывают" },
                { "ar": "إِلَّا", "ru": "только" },
                { "ar": "أَنْفُسَهُمْ", "ru": "самих себя" },
                { "ar": "وَمَا", "ru": "и не" },
                { "ar": "يَشْعُرُونَ", "ru": "осознают" }
            ]
        },
        {
            "id": 10,
            "translation": "Их сердца поражены болезнью. Пусть же Аллах увеличит их болезнь! Им уготована мучительная капля за то, что они лгали.",
            "words": [
                { "ar": "فِي", "ru": "в" },
                { "ar": "قُلُوبِهِمْ", "ru": "их сердцах" },
                { "ar": "مَرَضٌ", "ru": "болезнь" },
                { "ar": "فَزَادَهُمُ", "ru": "и увеличил им" },
                { "ar": "اللَّهُ", "ru": "Аллах" },
                { "ar": "مَرَضاً", "ru": "болезнь" },
                { "ar": "وَلَهُمْ", "ru": "и им" },
                { "ar": "عَذَابٌ", "ru": "наказание" },
                { "ar": "أَلِيمٌ", "ru": "мучительное" },
                { "ar": "بِمَا", "ru": "за то, что" },
                { "ar": "كَانُوا", "ru": "они" },
                { "ar": "يَكْذِبُونَ", "ru": "лгали" }
            ]
        },
        {
            "id": 11,
            "translation": "Когда им говорят: «Не распространяйте нечестия на земле!» — они отвечают: «Только мы и устанавливаем порядок».",
            "words": [
                { "ar": "وَإِذَا", "ru": "и когда" },
                { "ar": "قِيلَ", "ru": "говорят" },
                { "ar": "لَهُمْ", "ru": "им" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "تُفْسِدُوا", "ru": "сейте нечестие" },
                { "ar": "فِي", "ru": "на" },
                { "ar": "الْأَرْضِ", "ru": "земле" },
                { "ar": "قَالُوا", "ru": "они говорят" },
                { "ar": "إِنَّمَا", "ru": "поистине" },
                { "ar": "نَحْنُ", "ru": "мы" },
                { "ar": "مُصْلِحُونَ", "ru": "творящие благо" }
            ]
        },
        {
            "id": 12,
            "translation": "Воистину, именно они сеют нечестие, но они не осознают этого.",
            "words": [
                { "ar": "أَلَا", "ru": "о да" },
                { "ar": "إِنَّهُمْ", "ru": "воистину, они" },
                { "ar": "هُمُ", "ru": "именно они" },
                { "ar": "الْمُفْسِدُونَ", "ru": "сеющие нечестие" },
                { "ar": "وَلَكِنْ", "ru": "но" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "يَشْعُرُونَ", "ru": "осознают" }
            ]
        },
        {
            "id": 13,
            "translation": "Когда им говорят: «Уверуйте так, как уверовали люди», — они отвечают: «Неужели мы уверуем так, как уверовали глупцы?» Воистину, именно они являются глупцами, но они не знают этого.",
            "words": [
                { "ar": "وَإِذَا", "ru": "и когда" },
                { "ar": "قِيلَ", "ru": "говорят" },
                { "ar": "لَهُمْ", "ru": "им" },
                { "ar": "آمِنُوا", "ru": "уверуйте" },
                { "ar": "كَمَا", "ru": "так, как" },
                { "ar": "آمَنَ", "ru": "уверовали" },
                { "ar": "النَّاسُ", "ru": "люди" },
                { "ar": "قَالُوا", "ru": "они говорят" },
                { "ar": "أَنُؤْمِنُ", "ru": "неужели мы уверуем" },
                { "ar": "كَمَا", "ru": "так, как" },
                { "ar": "آمَنَ", "ru": "уверовали" },
                { "ar": "السُّفَهَاءُ", "ru": "глупцы" },
                { "ar": "أَلَا", "ru": "о да" },
                { "ar": "إِنَّهُمْ", "ru": "воистину, они" },
                { "ar": "هُمُ", "ru": "именно они" },
                { "ar": "السُّفَهَاءُ", "ru": "глупцы" },
                { "ar": "وَلَكِنْ", "ru": "но" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "يَعْلَمُونَ", "ru": "знают" }
            ]
        },
        {
            "id": 14,
            "translation": "Встречая верующих, они говорят: «Мы уверовали». Когда же они остаются со своими шайтанами, они говорят: «Воистину, мы с вами; мы лишь издеваемся».",
            "words": [
                { "ar": "وَإِذَا", "ru": "и когда" },
                { "ar": "لَقُوا", "ru": "они встречают" },
                { "ar": "الَّذِينَ", "ru": "тех, которые" },
                { "ar": "آمَنُوا", "ru": "уверовали" },
                { "ar": "قَالُوا", "ru": "говорят" },
                { "ar": "آمَنَّا", "ru": "мы уверовали" },
                { "ar": "وَإِذَا", "ru": "и когда" },
                { "ar": "خَلَوْا", "ru": "они остаются" },
                { "ar": "إِلَى", "ru": "к" },
                { "ar": "شَيَاطِينِهِمْ", "ru": "своим шайтанам" },
                { "ar": "قَالُوا", "ru": "говорят" },
                { "ar": "إِنَّا", "ru": "воистину, мы" },
                { "ar": "مَعَكُمْ", "ru": "с вами" },
                { "ar": "إِنَّمَا", "ru": "поистине" },
                { "ar": "نَحْنُ", "ru": "мы" },
                { "ar": "مُسْتَهْزِئُونَ", "ru": "издеваемся" }
            ]
        },
        {
            "id": 15,
            "translation": "Аллах поиздевается над ними и продлит их скитания, в которых они слепо бродят.",
            "words": [
                { "ar": "اللَّهُ", "ru": "Аллах" },
                { "ar": "يَسْتَهْزِئُ", "ru": "поиздевается" },
                { "ar": "بِهِمْ", "ru": "над ними" },
                { "ar": "وَيَمُدُّهُمْ", "ru": "и продлит им" },
                { "ar": "فِي", "ru": "в" },
                { "ar": "طُغْيَانِهِمْ", "ru": "их непокорности" },
                { "ar": "يَعْمَهُونَ", "ru": "бродят слепо" }
            ]
        },
        {
            "id": 16,
            "translation": "Именно они купили заблуждение за верное руководство. Но их сделка не принесла прибыли, и они не стали на правильный путь.",
            "words": [
                { "ar": "أُولَئِكَ", "ru": "таковые" },
                { "ar": "الَّذِينَ", "ru": "те, которые" },
                { "ar": "اشْتَرَوُا", "ru": "купили" },
                { "ar": "ضَّلَالَةَ", "ru": "заблуждение" },
                { "ar": "بِالْهُدَى", "ru": "в обмен на руководство" },
                { "ar": "فَمَا", "ru": "и не" },
                { "ar": "رَبِحَتْ", "ru": "прибыла" },
                { "ar": "تِجَارُتُهُمْ", "ru": "их торговля" },
                { "ar": "وَمَا", "ru": "и не" },
                { "ar": "كَانُوا", "ru": "были они" },
                { "ar": "مُهْتَدِينَ", "ru": "находящимися на верном пути" }
            ]
        },
        {
            "id": 17,
            "translation": "Подобно они тому, кто разжег огонь. Когда же огонь осветил все вокруг него, Аллах унес их свет и оставил их во тьме, где они ничего не видят.",
            "words": [
                { "ar": "مَثَلُهُمْ", "ru": "их притча" },
                { "ar": "كَمَثَلِ", "ru": "подобна" },
                { "ar": "الَّذِي", "ru": "тому, кто" },
                { "ar": "اسْتَوْقَدَ", "ru": "разожг" },
                { "ar": "نَاراً", "ru": "огонь" },
                { "ar": "فَلَمَّا", "ru": "и когда" },
                { "ar": "أَضَاءَتْ", "ru": "осветил" },
                { "ar": "مَا", "ru": "то, что" },
                { "ar": "حَوْلَهُ", "ru": "вокруг него" },
                { "ar": "ذَهَبَ", "ru": "унес" },
                { "ar": "اللَّهُ", "ru": "Аллах" },
                { "ar": "بِنُورِهِمْ", "ru": "их свет" },
                { "ar": "وَتَرَكَهُمْ", "ru": "и оставил их" },
                { "ar": "فِي", "ru": "в" },
                { "ar": "ظُلُمَاتٍ", "ru": "мраках" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "يُبْصِرُونَ", "ru": "видят" }
            ]
        },
        {
            "id": 18,
            "translation": "Глухие, немые, слепые! Они не возвращаются на прямой путь.",
            "words": [
                { "ar": "صُمٌّ", "ru": "глухие" },
                { "ar": "بُكْمٌ", "ru": "немые" },
                { "ar": "عُمْيٌ", "ru": "слепые" },
                { "ar": "فَهُمْ", "ru": "и они" },
                { "ar": "لَا", "ru": "не" },
                { "ar": "يَرْجِعُونَ", "ru": "возвратятся" }
            ]
        },
        {
            "id": 19,
            "translation": "Или же они подобны ливню с неба, в котором мраки, гром и молния. Они затыкают пальцами уши от ударов молнии, опасаясь смерти. Воистину, Аллах объемлет неверующих.",
            "words": [
                { "ar": "أَوْ", "ru": "или" },
                { "ar": "كَصَيِّبٍ", "ru": "подобно ливню" },
                { "ar": "مِنَ", "ru": "с" },
                { "ar": "السَّمَاءِ", "ru": "неба" },
                { "ar": "فِيهِ", "ru": "в нем" },
                { "ar": "ظُلُمَاتٌ", "ru": "мраки" },
                { "ar": "وَرَعْدٌ", "ru": "и гром" },
                { "ar": "وَبَرْقٌ", "ru": "и молния" },
                { "ar": "يَجْعَلُونَ", "ru": "они затыкают" },
                { "ar": "أَصَابِعَهُمْ", "ru": "свои пальцы" },
                { "ar": "فِي", "ru": "в" },
                { "ar": "آذَانِهِمْ", "ru": "свои уши" },
                { "ar": "مِنَ", "ru": "из-за" },
                { "ar": "الصَّوَاعِقِ", "ru": "молний" },
                { "ar": "حَذَرَ", "ru": "опасаясь" },
                { "ar": "المَوْتِ", "ru": "смерти" },
                { "ar": "وَاللَّهُ", "ru": "и Аллах" },
                { "ar": "مُحِيطٌ", "ru": "объемлет" },
                { "ar": "بِالْكَافِرِينَ", "ru": "неверующих" }
            ]
        },
        {
            "id": 20,
            "translation": "Молния чуть не слепит их глаза. Когда она освещает им путь, они идут при ней, а когда наступает темнота, они останавливаются. Если бы Аллах пожелал, Он лишил бы их слуха и зрения. Воистину, Аллах способен на всякую вещь.",
            "words": [
                { "ar": "يَكَادُ", "ru": "чуть не" },
                { "ar": "الْبَرْقُ", "ru": "молния" },
                { "ar": "يَخْطَفُ", "ru": "лишает" },
                { "ar": "أَبْصَارَهُمْ", "ru": "их зрения" },
                { "ar": "كُلَّمَا", "ru": "всякий раз, как" },
                { "ar": "أَضَاءَ", "ru": "освещает" },
                { "ar": "لَهُمْ", "ru": "им" },
                { "ar": "مَشَوْا", "ru": "они идут" },
                { "ar": "فِيهِ", "ru": "при нем" },
                { "ar": "وَإِذَا", "ru": "а когда" },
                { "ar": "أَظْلَمَ", "ru": "потемнеет" },
                { "ar": "عَلَيْهِمْ", "ru": "для них" },
                { "ar": "قَامُوا", "ru": "они останавливаются" },
                { "ar": "وَلَوْ", "ru": "и если бы" },
                { "ar": "شَاءَ", "ru": "пожелал" },
